<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace></RootNamespace>
    <NoWarn>CS0649;CS0169;CA1050;CA1822;CA2211;IDE1006</NoWarn>
    <FalloutRootDirectory>..\</FalloutRootDirectory>
    <FalloutScriptDirectory>..</FalloutScriptDirectory>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fallout.Common" Version="10.4.0" />
    <PackageReference Include="Polly" Version="8.8.0" />
  </ItemGroup>

  <!--
    TODO: Remove vulnerability overrides once the Fallout 10.x branch updates its own dependencies.

    Fallout.Common 10.4.0 pulls in System.Security.Cryptography.* 10.0.10, which has known
    vulnerabilities (NU1902/NU1903). The references below pin them to the latest patch release:
      - System.Security.Cryptography.Pkcs  10.0.10 -> 10.0.14  (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx)
      - System.Security.Cryptography.Xml   10.0.10 -> 10.0.14  (GHSA-7hqp-7c5m-4vq6, GHSA-c399-9853-6jmj, GHSA-r955-8q5j-3h83)
   -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.14" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <PackageDownload Include="GitVersion.Tool" Version="[6.8.2]" />
    <PackageDownload Include="ReportGenerator" Version="[5.5.11]" />
  </ItemGroup>
  <!--#if (UseGitHubActions)-->

  <ItemGroup>
    <Content Include="..\.github\dependabot.yml">
      <Link>ci\dependabot.yml</Link>
    </Content>
  </ItemGroup>
  <!--#endif-->
</Project>
