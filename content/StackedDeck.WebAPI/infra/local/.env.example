# 🖥️ Local observability stack environment variables.
#
# Copy this file to `.env` and adjust as needed — Docker Compose auto-loads
# `.env` from this directory. All values are optional; leaving any out falls
# back to the defaults embedded in `docker-compose.yml`.

# --- Container ---
# Version tag of the grafana/otel-lgtm image to use.
SD_LGTM_IMAGE_TAG=0.40.0
# Name assigned to the container (useful for `docker logs`).
SD_LGTM_CONTAINER_NAME=stackeddeck-lgtm

# --- Ports ---
# Grafana UI port (http://localhost:<port>)
SD_LGTM_GRAFANA_PORT=3000
# Prometheus UI port (http://localhost:<port>, for debugging)
SD_PROMETHEUS_PORT=9090
# OTLP gRPC port — the API pushes traces/metrics here (OTEL mode).
SD_OTLP_GRPC_PORT=4317
# OTLP HTTP port
SD_OTLP_HTTP_PORT=4318

# --- Grafana credentials ---
# ⚠️ Local development only. The stack ships with well-known local defaults
# (`admin` / `admin`, embedded in `docker-compose.yml`) — leaving these empty
# falls back to those defaults. Assign values here to override them, and never
# reuse credentials from other systems.
SD_GRAFANA_ADMIN_USER=
SD_GRAFANA_ADMIN_PASSWORD=
